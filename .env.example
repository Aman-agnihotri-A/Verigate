# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=change-me-dev-only
ADMIN_API_KEY=change-me-admin-key

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=verigate

# --- Admin / MIS access ---
ADMIN_API_KEY=change-me-admin-key

# --- Vendor simulation ---
VENDOR_A_FAILURE_RATE=0.2
VENDOR_A_TIMEOUT_RATE=0.1
VENDOR_A_TIMEOUT_BUDGET_MS=2000
VENDOR_LATENCY_MIN_MS=100
VENDOR_LATENCY_MAX_MS=800

# --- TPS / rate limiting ---
DEFAULT_TPS_LIMIT=5

# --- IP trust boundary ---
TRUSTED_PROXY_IPS=127.0.0.1
TRUST_XFF_HEADER_DEV_ONLY=false

# --- Emergency audit fallback ---
EMERGENCY_LOG_PATH=logs/emergency_fallback.jsonl
